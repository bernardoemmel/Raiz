  "ferramentas": {
    "acompanhar_contato": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Acompanha o estado do pedido e o interesse agregado dos donos. O contato passa pela Raíz; nunca sai\n        contato pessoal. Estados: submitted, working, input-required, completed, failed e canceled.\n        Repetições da mesma intenção devem preservar a Idempotency-Key.",
      "inputSchema": {
        "properties": {
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "pedido_id": {
            "format": "uuid",
            "title": "Pedido Id",
            "type": "string"
          }
        },
        "required": [
          "pedido_id",
          "idempotency_key"
        ],
        "title": "acompanhar_contatoArguments",
        "type": "object"
      },
      "name": "acompanhar_contato",
      "outputSchema": {
        "additionalProperties": true,
        "title": "acompanhar_contatoDictOutput",
        "type": "object"
      }
    },
