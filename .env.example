# Copie para .env e preencha (nunca suba o .env para o GitHub)
MAPBIOMAS_ALERTA_EMAIL=
MAPBIOMAS_ALERTA_SENHA=
# Front: pasta com os CSV do motor separados por estado (<pasta>/<UF>/imoveis_<cod>.csv...). Sem ela, o front usa
# dados/estados/ (que o npm run dev baixa sozinho do Release "dados") e, sem internet, dados/amostra/.
# RAIZ_DADOS=motor/saida

# Produto (raiz/): banco, cifra do esquema pessoal e Healthchecks
RAIZ_BANCO_URL=postgresql+psycopg://raiz:raiz@localhost:5432/raiz
RAIZ_CHAVE_PESSOAL=
RAIZ_HEALTHCHECKS_CHAVE_PING=
RAIZ_BANCO_URL_TESTE=

# Modelos de linguagem (E7): chave da Anthropic, llama.cpp local e Langfuse próprio
ANTHROPIC_API_KEY=
RAIZ_LLAMA_URL=http://localhost:8080
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# WhatsApp Cloud API (PyWa) e token do backoffice para a API
RAIZ_WHATSAPP_PHONE_ID=
RAIZ_WHATSAPP_TOKEN=
RAIZ_WHATSAPP_VERIFY_TOKEN=
RAIZ_WHATSAPP_APP_SECRET=
RAIZ_API_TOKEN=
# origens do front que podem chamar a API pelo navegador, separadas por vírgula (ex.: http://localhost:5173)
RAIZ_API_ORIGENS=
# Limite compartilhado (Valkey): necessário para mais de um worker; vazio usa contador local.
RAIZ_API_LIMITE_MINUTO=120
RAIZ_API_LOGIN_LIMITE_MINUTO=10
RAIZ_API_LIMITE_STORAGE_URL=
RAIZ_API_LIMITE_CHAVE=
# GlitchTip próprio (infra/docker-compose.observabilidade.yml); segredos fortes, independentes.
RAIZ_GLITCHTIP_DSN=
RAIZ_GLITCHTIP_BANCO_SENHA=
RAIZ_GLITCHTIP_SECRET_KEY=
RAIZ_VALKEY_SENHA=
RAIZ_GLITCHTIP_DOMAIN=http://localhost:8001
RAIZ_GLITCHTIP_HOSTS=localhost,127.0.0.1
# URL canônica do painel para o link por e-mail; inclua a subpasta (ex.: https://painel.exemplo.org/Raiz/).
# Sem valor, usa a primeira RAIZ_API_ORIGENS; nunca usa Origin ou Host enviado pelo visitante.
RAIZ_LOGIN_BASE_URL=
RAIZ_HEALTHCHECKS_MODELO_SLUG=raiz-{tarefa}
# Escalonamento dos alertas de operação (raiz operacao alertas): ntfy e, com segunda pessoa, GoAlert.
# Vazio = envio simulado e registrado no alerta. O tópico do ntfy funciona como senha: nome longo e aleatório.
RAIZ_NTFY_URL=https://ntfy.sh
RAIZ_NTFY_TOPICO=
RAIZ_NTFY_TOKEN=
RAIZ_GOALERT_URL=
RAIZ_ESPELHO_DIR=
RAIZ_ORCAMENTO_MENSAL_USD=

# Langfuse próprio (infra/docker-compose.langfuse.yml); gere segredos com: openssl rand -hex 32
RAIZ_BANCO_SENHA=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_CLICKHOUSE_SENHA=
LANGFUSE_VALKEY_SENHA=
LANGFUSE_S3_CHAVE=
LANGFUSE_S3_SEGREDO=
# R2 em vez do SeaweedFS local: LANGFUSE_S3_ENDERECO=https://<conta>.r2.cloudflarestorage.com
LANGFUSE_S3_ENDERECO=
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_SENHA=

# cache dos blocos de rasters na nuvem
RAIZ_RASTER_CACHE_DIR=
# pasta com o que front/scripts/geo.py gera (GeoJSON das camadas e base_<mun>.pmtiles); padrão front/geo
RAIZ_GEO_DIR=
# mapa base do Brasil (raiz mapa atualizar: recorte do Protomaps, fontes e sprites); padrão dados/mapa
RAIZ_MAPA_DIR=
# imagens de satélite por fazenda (Sentinel-2 e Landsat em WebP); padrão dados/imagens
RAIZ_IMAGENS_DIR=
# cache das entradas do valor para quem restaura (Copernicus, CHIRPS, SoilGrids); vazio = dados/cache_restauracao
RAIZ_CACHE_RESTAURACAO_DIR=
# cartões, adesivos e vídeos públicos (cache); padrão dados/publico
RAIZ_PUBLICO_DIR=
# fichas JSON gravadas em lote (raiz ficha lote); padrão dados/fichas
RAIZ_FICHAS_DIR=
# revisor de estilo e legibilidade (LanguageTool em infra/languagetool); vazio = só a nota do medidor
RAIZ_LANGUAGETOOL_URL=
# lista aberta de palavras comuns para o Gunning Fog (uma por linha); vazio = palavra de 4 sílabas ou mais é complexa
RAIZ_PALAVRAS_COMUNS=
RAIZ_RASTER_CACHE_GB=20

# Armazém dos arquivos do motor (agente Dados). Vazio = produção: o Release "dados" do GitHub
# (release-github://bernardoemmel/raiz/dados); grava só com GH_TOKEN ou GITHUB_TOKEN (Actions), sem token só lê.
# Pasta local para testes (ex.: dados/armazem). S3 (Cloudflare R2 ou SeaweedFS) é opção futura: s3://balde/prefixo.
RAIZ_ARMAZEM_URL=
RAIZ_S3_ENDPOINT=
RAIZ_S3_REGIAO=auto
RAIZ_S3_ACCESS_KEY_ID=
RAIZ_S3_SECRET_ACCESS_KEY=
RAIZ_ARMAZEM_ESPELHO_DIR=

# Pedido de lote: cobrança Pix da reserva pela AbacatePay. Vazio = modo de teste (cobrança local, sem pagar nada).
RAIZ_ABACATEPAY_CHAVE=
RAIZ_ABACATEPAY_WEBHOOK_SEGREDO=

# Documentos (raiz/documentos): modelo e esforço da leitura de certidão e edital (padrão claude-opus-5-5 e high)
RAIZ_MODELO_DOCUMENTO=
RAIZ_ESFORCO_DOCUMENTO=
# opcional: Firecrawl (API hospedada) para o registro da Verra e o Diário Oficial quando o acesso direto falha
FIRECRAWL_API_KEY=
# como o dono fala com a Raíz (aparece na folha do dono)
RAIZ_CONTATO=

# Plataforma de agentes: exporte estas variáveis no ambiente da API e do worker.
# O MCP permanece fechado enquanto emissor/recurso não forem configurados.
RAIZ_API_PUBLICA_URL=
RAIZ_FRONT_URL=
RAIZ_OAUTH_ISSUER=
RAIZ_MCP_RESOURCE=
RAIZ_MCP_HOSTS=
RAIZ_OAUTH_REDIRECT_URI=
RAIZ_KEYCLOAK_URL=
RAIZ_KEYCLOAK_BANCO_SENHA=
RAIZ_KEYCLOAK_ADMIN=
RAIZ_KEYCLOAK_ADMIN_SENHA=
# Valkey compartilhado entre processos (cliente redis-py MIT; não usar servidor Redis de licença restritiva).
# RAIZ_API_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# URL OTLP/HTTP completa. Sem ela, não há armazenamento externo de traces.
RAIZ_OTEL_ENDPOINT=
# Ed25519: 32 bytes aleatórios em base64url; nunca reutilizar chave de teste.
RAIZ_RECIBO_CHAVE=
# Lista de hosts HTTPS exatos permitidos como destinatários dos eventos.
RAIZ_WEBHOOK_HOSTS=
RAIZ_REVISAO_HUMANA_TOKEN=
# Login humano por e-mail: SSL ou STARTTLS obrigatório; vazio deixa envio indisponível.
RAIZ_SMTP_HOST=
RAIZ_SMTP_FROM=
RAIZ_SMTP_PORT=465
RAIZ_SMTP_TLS=ssl
RAIZ_SMTP_USER=
RAIZ_SMTP_PASSWORD=
# Somente habilitar após confirmar suporte contratual do provedor a Idempotency-Key.
RAIZ_ABACATEPAY_IDEMPOTENCIA_SUPORTADA=0
