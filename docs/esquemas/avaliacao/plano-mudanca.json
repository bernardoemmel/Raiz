          "type": "integer"
        },
        "porte": {
          "enum": [
            "pequena",
            "media",
            "grande"
          ],
          "title": "Porte",
          "type": "string"
        },
        "aptidao": {
          "enum": [
            "baixa",
            "media",
            "alta"
